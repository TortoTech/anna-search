{
  "name": "anna-search",
  "version": "0.1.0",
  "private": true,
  "description": "Anna's Archive zlib3_records local metadata search MVP (PostgreSQL 16 FTS)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "ingest": "tsx src/ingest.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e.test.ts"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.2",
    "tinyglobby": "^0.2.17",
    "zod": "^4.1.0",
    "zstd-napi": "^0.0.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}

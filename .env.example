# docker-compose 配置
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_PORT=5432
API_PORT=3000

# Anna's Archive 详情页域名（逗号分隔，第一个用于生成 URL）
ANNAS_DOMAINS=annas-archive.gl,annas-archive.gd,annas-archive.pk

# 本机直接运行（不走 docker）时使用
DATABASE_URL=postgresql://annas:change-me-to-a-long-random-string@localhost:5432/annas
